{
  "manifest_version": 3,
  "name": "GuardianAI",
  "version": "0.1.0",
  "description": "AI-powered browser security extension for website threat detection.",
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:5000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}